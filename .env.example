# Strava API credentials (required)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Dawarich (optional - leave blank to skip auto-push)
DAWARICH_URL=https://your-dawarich-instance.com
DAWARICH_API_KEY=your_api_key

# Home location for virtual rides (lat,lon) — anchors virtual activities here
# instead of the virtual world GPS, preventing teleport distance in Dawarich
HOME_LOCATION=41.8781,-87.6298
